  "hasPart": [
    {
      "@type": "LearningResource",
      "name": "Fragestellung und Operationalisierung. Einführung in die Fallstudie",
      "description": "Das Kapitel bildet den Auftakt der Fallstudie und klärt das Erkenntnisinteresse, das die anschließende Vorbereitung und Aufbereitung des Korpus sowie die Analyse leitet.",
      "url": "https://quadriga-dk.github.io/Text-Fallstudie-3/research_question/research-question_intro.html#research-question-intro",
      "timeRequired": "PT45M",
      "teaches": "Grundlagen korpusbasierter geisteswissenschaftlicher Forschung",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Die Entwicklung einer Digital Humanities-Fragestellung kann am Beispiel der Messung der diskursivierten Luftqualität in der Literatur des 19. Jahrhunderts nachvollzogen und erläutert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: nicht anwendbar | Bloom's: 2 Verstehen | Data Flow: nicht anwendbar"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Der Operationalisierungsprozess kann am Beispiel der diskursivierten Luftqualität in der Literatur des 19. Jahrhunderts nachvollzogen und auf andere Forschungsfragen übertragen werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 1.1 Identifikation | Bloom's: 3 Anwenden | Data Flow: 1 Planung"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Korpusaufbau. Auswählen, sammeln, dokumentieren",
      "description": "Nachdem im vorherigen Kapitel die Fragestellung und deren Operationalisierung erläutert wurden, wird der Forschungsgegenstand im Sinne der Operationalisierung vorbereitet. Dazu wird ein Korpus zusammengestellt, anhand dessen sich die deutschsprachige Literatur des 19. Jahrhunderts untersuchen lässt.",
      "url": "https://quadriga-dk.github.io/Text-Fallstudie-3/corpus_collection/corpus-collection_intro.html#corpus-collection-intro",
      "timeRequired": "PT3H",
      "teaches": "Ansätze des Korpusaufbaus und Erstellung basaler Metadaten",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Korpora können als geisteswissenschaftliche Forschungsobjekte definiert und deren wesentliche Merkmale beschrieben werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die vier Hauptformate digitaler Texte (Bilddigitalisate, Plain Text, XML/TEI, CSV) können anhand ihrer charakteristischen Eigenschaften unterschieden und deren Vor- und Nachteile für spezifische Anwendungsfälle analysiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 4 Analysieren | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die grundlegenden Metadatenschemata (Dublin Core, TEI, MODS, METS) und deren charakteristische Elemente für Korpora und Einzeldokumente können beschrieben werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Der Prozess der Korpusauswahl unter Einbeziehung der Korpusgröße und des abgedeckten Zeitraums kann in Hinblick auf die Forschungsfrage erläutert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Korpusverarbeitung. Von Strings zu Token",
      "description": "Das Kapitel führt konzeptionell in die Methoden der Anreicherung ein (Tokenisierung, Lemmatisierung und POS-Tagging) und zeigt, welche Möglichkeiten die Programmiersprache Python für die Anreicherung bietet.",
      "url": "https://quadriga-dk.github.io/Text-Fallstudie-3/corpus_processing/corpus-processing_intro.html",
      "timeRequired": "PT2H",
      "teaches": "Korpusverarbeitung mit Natural Language Processing",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Die Grundkonzepte des Natural Language Processing können erklärt und die Funktionen von Tokenisierung, Lemmatisierung, POS-Tagging und Dependency Parsing für die Textanalyse beschrieben werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 2.3 Aufbereitung | Bloom's: 2 Verstehen | Data Flow: 2 Erhebung und Aufbereitung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die notwendigen Schritte zur automatischen Annotation eines Texts können aufgezählt und Vorteile der Tokenisierung gegenüber einfacheren Methoden der Worttrennung genannt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 2.3 Aufbereitung | Bloom's: 2 Verstehen | Data Flow: 2 Erhebung und Aufbereitung"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Korpusanalyse. Semantische Felder und syntaktische N-Gramme",
      "description": "Das Kapitel greift die Forschungsfrage und ihre zweiteilige Operationalisierung auf. Es werden zwei Analysen auf den beiden Korpora durchgeführt. Die erste Analyse ist eine Häufigkeitsanalyse des semantischen Felds „Luft“, die zweite eine Analyse syntaktischer N-Gramme. In der Häufigkeitsanalyse wird für jeden Text die relative Häufigkeit luftbezogener Wörter berechnet und ihre Entwicklung als Streudiagramm mit Trend-Linie über die Zeit dargestellt. In der Analyse syntaktischer N-Gramme werden – aufbauend auf den Grenzen linearer N-Gramme – mithilfe der Dependenzannotation die Adjektive extrahiert, mit denen „Luft“ näher beschrieben wird, und ihre Entwicklung über die Jahrzehnte betrachtet.",
      "url": "https://quadriga-dk.github.io/Text-Fallstudie-3/corpus_analysis/corpus-analysis_intro.html",
      "timeRequired": "PT3H45M",
      "teaches": "Frequenzanalysen semantischer Felder und syntaktischer n-Gramm-Abhängigkeiten",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Das Konzept des semantischen Feldes kann erklärt, der Unterschied zwischen absoluten und relativen Häufigkeiten beschrieben und die Darstellungsmethoden des Streudiagramms sowie des Liniendiagramms können interpretiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 4 Analysieren | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Das Konzept von syntaktischen n-Grams in Bezug auf Adjektiv-Nomen-Paare kann beschrieben und die notwendigen Schritte zur automatischen Extraktion der syntaktischen n-Grams können aufgezählt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 2 Verstehen | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Das Konzept einer Trend-Linie kann beschrieben und die aus einem Streudiagramm erzeugte Trend-Linie interpretiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.2 Visualisierung | Bloom's: 4 Analysieren | Data Flow: 4 Analyse"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Reflexion",
      "description": "Das Kapitel geht der Frage nach, ob sich in der deutschsprachigen Literatur des 19. Jahrhunderts Reaktionen auf die zunehmende Luftverschmutzung durch die Industrialisierung ausmachen lassen. Dazu werden zwei quantitative Analysen durchgeführt. Zunächst erfolgt eine diachrone Häufigkeitsanalyse des semantischen Felds „Luft“. Es wird erwartet, dass Luft über die Zeit vermehrt thematisiert wird, das heißt, dass die Wörter des semantischen Felds häufiger vorkommen. Anschließend wird untersucht, ob sich die Semantisierung von Luft über die Zeit verändert. Dafür werden syntaktische N-Grams in Form von Adjektiv-Substantiv-Paaren analysiert, bei denen das Substantiv „Luft“ ist. Es wird davon ausgegangen, dass sich die Semantisierung verändert und Literatur auf diese Art auf die historischen Gegebenheiten reagiert.",
      "url": "https://quadriga-dk.github.io/Text-Fallstudie-3/reflection/reflection_reflection.html",
      "timeRequired": "PT30M",
      "teaches": "Kritische Bewertung der Reichweite und Limitationen",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Die Reichweite der in einer Digital-Humanities-Fallstudie gewonnenen Erkenntnisse für die fachwissenschaftliche Forschung kann eingeschätzt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.3 Interpretation | Bloom's: 5 Bewerten | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die methodischen Limitationen einer Digital-Humanities-Fallstudie können benannt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.3 Interpretation | Bloom's: 5 Bewerten | Data Flow: 4 Analyse"
        }
      ]
    }
  ],
