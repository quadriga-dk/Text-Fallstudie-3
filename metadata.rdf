  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Text-Fallstudie-2/#chapter_4_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: nicht anwendbar | Bloom's: nicht anwendbar | Data Flow: nicht anwendbar</schema:targetDescription>
    <schema:targetName>Sie können die Komponenten aufzählen, die an einem HTTP-Request beteiligt sind, den Unterschied zwischen dem Aufbau eines HTTP-Requests und einer HTTP-Response erläutern sowie die Response codes 200, 404, 403 und 500 interpretieren.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Text-Fallstudie-2/#chapter_4_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
