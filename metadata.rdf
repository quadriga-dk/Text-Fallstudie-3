  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Text-Fallstudie-2/#chapter_4_objective_2">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: nicht anwendbar | Bloom's: nicht anwendbar | Data Flow: nicht anwendbar</schema:targetDescription>
